---
/**
 * [MODÜL: KİMLİK DOĞRULAMA SAYFA ŞABLONU]
 * Amaç: Giriş, kayıt ve şifre sayfalarının ortak, odaklı tam ekran düzeni.
 *   - Sol (lg+): dört sütun genişliğinde, sakin marka ve güven paneli
 *   - Sağ: sekiz sütun genişliğinde, ferah ve odaklı form alanı
 *
 * Tasarım kararları:
 *   - Site menüsü ve footer gizlenir (`chrome="minimal"`): kullanıcı formu tamamlarken dikkat dağılmaz.
 *   - Giriş/kayıt geçişi formun üstünde görünür; kullanıcı hangi akışta olduğunu kaybetmez.
 *   - Kart genişliği uzun satırları engeller, arka plan ise geniş ekrandaki boşluğu dengeler.
 */
import { ArrowLeft, Check, LockKeyhole, ShieldCheck, Sparkles } from '@/shared/ui';
import { ROUTES, SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialAuthOptions from './SocialAuthOptions.astro';

interface Props {
  title: string;
  heading: string;
  subheading?: string;
  /** Yalnızca giriş/kayıt sayfalarında Google/LinkedIn ile devam seçeneklerini gösterir. */
  socialIntent?: 'login' | 'register';
}

const { title, heading, subheading, socialIntent } = Astro.props;

const benefits = [
  'İlan ve etkinlik başvurularını tek yerden yönet',
  'Profilini bir kez oluştur, fırsatlara kolayca başvur',
  'Başvuru durumlarını dilediğin zaman takip et',
];
const authTabs = [
  { intent: 'login', label: 'Giriş yap', href: ROUTES.login },
  { intent: 'register', label: 'Kayıt ol', href: ROUTES.register },
] as const;
const year = new Date().getFullYear();
---

<BaseLayout title={title} noindex chrome="minimal">
  <div class="grid min-h-dvh bg-slate-50 lg:grid-cols-[minmax(20rem,4fr)_minmax(0,8fr)]">
    <!-- Marka paneli (yalnızca masaüstü) -->
    <aside class="relative hidden bg-gray-950 text-white lg:block">
      <div class="sticky top-0 flex h-dvh flex-col justify-between overflow-hidden p-9 xl:p-12 2xl:p-14">
        <!-- Dekoratif katmanlar -->
        <div class="pointer-events-none absolute -left-32 -top-32 h-[24rem] w-[24rem] rounded-full bg-primary-700/20 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-40 -right-32 h-[24rem] w-[24rem] rounded-full bg-primary-900/20 blur-3xl" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.04] [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent)]"
          aria-hidden="true"
        >
        </div>

        <div class="relative flex items-center justify-between gap-4">
          <a href={ROUTES.home} class="w-fit" aria-label={`${SITE.name} ana sayfa`}>
            <img src={SITE.logoWhite} alt={SITE.name} class="h-auto w-32 xl:w-36" />
          </a>
          <span class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
            <ShieldCheck size={14} className="text-primary-300" aria-hidden="true" />
            Güvenli hesap
          </span>
        </div>

        <div class="relative">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-primary-300">Youthside'a hoş geldin</p>
          <p class="max-w-sm text-3xl font-black leading-[1.08] tracking-[-0.04em] xl:text-[2.65rem]">
            Kariyer yolculuğun<br /><span class="text-primary-400">kaldığı yerden</span> devam etsin.
          </p>
          <p class="mt-4 max-w-sm text-sm leading-6 text-slate-400">
            Fırsatlarını, etkinliklerini ve başvurularını güvenli hesabından kolayca yönet.
          </p>
          <ul class="mt-7 max-w-sm space-y-3.5">
            {
              benefits.map((text) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-500/15 text-primary-300 ring-1 ring-primary-400/20">
                    <Check size={12} strokeWidth={3} aria-hidden="true" />
                  </span>
                  <span class="text-[13px] leading-5 text-slate-300">{text}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="relative border-t border-white/10 pt-5 text-xs text-slate-500">
          <p class="flex items-center gap-2">
            <LockKeyhole size={15} className="text-slate-400" aria-hidden="true" />
            Verilerin güvenli oturum ve KVKK ilkeleriyle korunur.
          </p>
        </div>
      </div>
    </aside>

    <!-- Form sütunu -->
    <div class="relative flex min-h-dvh min-w-0 flex-col overflow-hidden bg-slate-50">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_right,var(--color-primary-100),transparent_62%)] opacity-50" aria-hidden="true"></div>

      <header class="relative flex items-center justify-between gap-4 px-4 py-4 sm:px-8 lg:px-10 lg:py-5 xl:px-14">
        <a href={ROUTES.home} class="lg:invisible" aria-label={`${SITE.name} ana sayfa`}>
          <img src={SITE.logo} alt={SITE.name} class="h-auto w-28" />
        </a>
        <a href={ROUTES.home} class="flex min-h-11 items-center gap-2 rounded-xl px-3 text-sm font-semibold text-slate-500 transition hover:bg-white hover:text-slate-800">
          <ArrowLeft size={17} strokeWidth={2.25} aria-hidden="true" />
          <span class="hidden min-[390px]:inline">Ana sayfa</span>
        </a>
      </header>

      <main class="relative flex flex-1 items-start justify-center px-3 pb-5 pt-1 sm:px-8 sm:pb-8 sm:pt-3 lg:items-center lg:px-10 lg:py-6">
        <div class="w-full max-w-[480px]">
          <section class="rounded-3xl border border-slate-200/70 bg-white p-4 shadow-soft sm:p-6" aria-labelledby="auth-heading">
            {
              socialIntent && (
                <nav aria-label="Hesap işlemleri" class="mb-5 grid grid-cols-2 gap-1 rounded-xl bg-slate-100/80 p-1">
                  {authTabs.map((tab) => {
                    const active = tab.intent === socialIntent;
                    return (
                      <a
                        href={tab.href}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'flex min-h-11 items-center justify-center rounded-lg px-3 text-sm font-semibold transition',
                          active ? 'bg-white text-slate-950 shadow-sm ring-1 ring-slate-200/70' : 'text-slate-500 hover:text-slate-800',
                        ]}
                      >
                        {tab.label}
                      </a>
                    );
                  })}
                </nav>
              )
            }

            <div class="flex items-start gap-3.5">
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700 ring-1 ring-primary-100" aria-hidden="true">
                <Sparkles size={18} strokeWidth={2.25} />
              </div>
              <div>
                <h1 id="auth-heading" class="text-2xl font-black leading-tight tracking-[-0.035em] text-slate-950 sm:text-[28px]">{heading}</h1>
                {subheading && <p class="mt-1 text-sm leading-5 text-slate-500">{subheading}</p>}
              </div>
            </div>

            <div class="mt-4">
              {socialIntent && <SocialAuthOptions intent={socialIntent} />}
              <slot />
            </div>

            <div class="mt-5 flex items-center justify-center gap-2 border-t border-slate-100 pt-4 text-center text-[11px] font-medium text-slate-400">
              <LockKeyhole size={13} aria-hidden="true" />
              <span>Bilgilerin güvenli bağlantı üzerinden iletilir.</span>
            </div>
          </section>
        </div>
      </main>

      <footer class="relative flex flex-wrap items-center justify-center gap-x-5 gap-y-2 px-5 py-3 text-[11px] text-slate-400 sm:justify-between sm:px-8 lg:px-10 xl:px-14">
        <span>© {year} {SITE.name}</span>
        <nav aria-label="Yasal" class="flex gap-5">
          <a href={ROUTES.agreements('hizmet-sozlesmesi')} class="hover:text-gray-700">Kullanım koşulları</a>
          <a href={ROUTES.agreements('kvkk')} class="hover:text-gray-700">KVKK</a>
          <a href={`mailto:${SITE.supportEmail}`} class="hover:text-gray-700">Destek</a>
        </nav>
      </footer>
    </div>
  </div>
</BaseLayout>
