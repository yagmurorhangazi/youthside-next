---
/**
 * [MODÜL: İLAN KARTI]
 * Amaç: Bir ilanı kapak, şirket ve karar vermek için gereken temel bilgilerle listelemek.
 * SRP: Kart yalnızca görüntüler; son başvuru kuralı `getDeadlineInfo`'da, URL üretimi `ROUTES`'ta.
 * Neden: Liste ekranında ayrıntı kalabalığı yerine şirket, pozisyon, çalışma biçimi ve son
 *        başvuru tarihi öne çıkar; ayrıntılı içerik ilan sayfasına bırakılır.
 */
import { ArrowUpRight, Briefcase, CalendarClock, House, MapPin, Sparkles } from 'lucide-react';
import { ROUTES } from '@/config/site';
import OrganizationAttribution from '@/shared/ui/OrganizationAttribution.astro';
import { getDeadlineInfo, type DeadlineTone } from '../lib/deadline';
import type { JobSummary } from '../types';

interface Props {
  job: JobSummary;
  /** Şirket profili içinde şirket adı tekrar gösterilmez. */
  hideCompany?: boolean;
  /** Ekranın ilk görünen kartlarında görsel tembel yüklenmez (LCP). */
  eager?: boolean;
}

const { job, hideCompany = false, eager = false } = Astro.props;
const deadline = getDeadlineInfo(job.expirationDate);
const location = job.locations.length > 0 ? job.locations.join(', ') : 'Lokasyon belirtilmemiş';
const href = ROUTES.jobDetail(job.company.slug, job.slug);
const companyHref = ROUTES.company(job.company.slug);

/** Aciliyet seviyesinin renk karşılığı (görünüm kararı kartta, iş kuralı lib'de). */
const toneClass: Record<DeadlineTone, string> = {
  muted: 'text-gray-400',
  normal: 'text-gray-500',
  soon: 'text-amber-600',
  urgent: 'text-orange-600 font-bold',
  expired: 'text-red-500',
};
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-[28px] border border-slate-200/80 bg-white shadow-card card-interactive focus-within:border-primary-300 focus-within:ring-4 focus-within:ring-primary-500/10">
  <!-- Kapak -->
  <div class="relative mx-3 mt-3 aspect-video overflow-hidden rounded-[20px] bg-linear-to-br from-primary-100 via-orange-50 to-purple-100">
    {
      job.coverImageUrl ? (
        <img
          src={job.coverImageUrl}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover media-zoom"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-primary-300" aria-hidden="true">
          <Briefcase size={44} strokeWidth={1.5} />
        </div>
      )
    }
    <div class="absolute inset-0 bg-linear-to-t from-gray-950/35 via-transparent to-transparent"></div>
    {
      (job.isPinned || job.isFeatured) && (
        <span class="absolute right-3 top-3 flex items-center gap-1.5 rounded-full border border-white/70 bg-white/95 px-3 py-1.5 text-[11px] font-bold text-primary-700 shadow-sm backdrop-blur-sm">
          <Sparkles size={13} aria-hidden="true" />
          Öne çıkan
        </span>
      )
    }
  </div>

  {
    !hideCompany && (
      <div class="relative -mt-8 px-4">
        <OrganizationAttribution name={job.company.name} logoUrl={job.company.logoUrl} href={companyHref} label="İlanı yayınlayan" />
      </div>
    )
  }

  <!-- İçerik -->
  <div class:list={['flex grow flex-col px-5 pb-5 text-center sm:px-6 sm:pb-6', hideCompany ? 'pt-5' : 'pt-4']}>
    <h3 class="line-clamp-2 text-xl font-extrabold leading-snug tracking-[-0.02em] text-slate-950 transition-colors group-hover:text-primary-700">
      {job.title}
    </h3>
    {job.excerpt && <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">{job.excerpt}</p>}

    <div class="mt-4 flex flex-wrap justify-center gap-2">
      {
        job.type && (
          <span class="flex items-center gap-1.5 rounded-lg border border-blue-100 bg-blue-50 px-2.5 py-1.5 text-[11px] font-bold text-blue-700">
            <Briefcase size={14} aria-hidden="true" />
            {job.type}
          </span>
        )
      }
      {
        job.workModel && (
          <span class="flex items-center gap-1.5 rounded-lg border border-teal-100 bg-teal-50 px-2.5 py-1.5 text-[11px] font-bold text-teal-700">
            <House size={14} aria-hidden="true" />
            {job.workModel}
          </span>
        )
      }
    </div>

    <!-- Karar bilgileri ve açık aksiyon, referanstaki hiyerarşiyi Youthside diline taşır. -->
    <div class="mt-auto grid grid-cols-2 divide-x divide-slate-200 pt-6">
      <div class="min-w-0 px-2">
        <span class="flex items-center justify-center gap-1 text-[9px] font-semibold uppercase tracking-[0.08em] text-slate-400">
          <MapPin size={12} aria-hidden="true" />
          Konum
        </span>
        <strong class="mt-1 block truncate text-sm font-semibold text-slate-800" title={location}>{location}</strong>
      </div>
      <div class="min-w-0 px-2">
        <span class="flex items-center justify-center gap-1 text-[9px] font-semibold uppercase tracking-[0.08em] text-slate-400">
          <CalendarClock size={12} aria-hidden="true" />
          Son başvuru
        </span>
        <strong class:list={['mt-1 block truncate text-sm font-semibold', toneClass[deadline.tone]]}>{deadline.label}</strong>
      </div>
    </div>

    <a href={href} class="relative z-20 mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-primary-600 px-5 text-sm font-semibold text-white shadow-lg shadow-primary-600/20 transition hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-500/25">
      İlanı incele
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>
</article>
