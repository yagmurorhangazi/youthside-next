---
/**
 * [MODÜL: ŞİRKET / KULÜP KARTI]
 * Amaç: Liste sayfalarında şirket veya kulübü kapak, logo, sektör/üniversite ve açık
 *       fırsat sayılarıyla göstermek. Kulüplerde ilan sayısı yerine üniversite gösterilir.
 */
import { BadgeCheck, Briefcase, CalendarDays, GraduationCap, Users } from 'lucide-react';
import { ROUTES } from '@/config/site';
import CompanyLogo from '@/shared/ui/CompanyLogo.astro';
import type { CompanySummary } from '../types';

interface Props {
  company: CompanySummary;
}

const { company } = Astro.props;
const isClub = company.type === 'club';
const subtitle = isClub ? company.university : company.sector;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm card-interactive">
  <div class="relative h-28 bg-linear-to-br from-gray-800 via-gray-700 to-primary-800 sm:h-32">
    {company.coverImageUrl && <img src={company.coverImageUrl} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover opacity-90 media-zoom" />}
    <div class="absolute -bottom-7 left-5 z-10">
      <CompanyLogo name={company.name} src={company.logoUrl} />
    </div>
  </div>

  <div class="flex grow flex-col p-5 pt-10">
    <h3 class="flex items-center gap-1.5 text-lg font-bold leading-snug text-gray-900 transition-colors group-hover:text-primary-600">
      <a href={ROUTES.company(company.slug)} class="line-clamp-2 after:absolute after:inset-0 after:content-['']">{company.name}</a>
      {company.isVerified && <BadgeCheck size={18} className="shrink-0 text-blue-500" aria-label="Onaylı hesap" />}
    </h3>
    {
      subtitle && (
        <p class="mt-1 flex items-center gap-1 text-sm font-medium text-gray-500">
          {isClub ? <GraduationCap size={15} className="shrink-0" aria-hidden="true" /> : null}
          <span class="truncate">{subtitle}</span>
        </p>
      )
    }
    {company.about && <p class="mt-3 line-clamp-3 text-[13px] leading-relaxed text-gray-500">{company.about}</p>}

    <div class="mt-auto flex flex-wrap gap-2 pt-4 text-xs font-bold">
      {
        !isClub && (
          <span class:list={['flex items-center gap-1 rounded-lg px-2.5 py-1.5', company.jobsCount > 0 ? 'bg-primary-50 text-primary-700' : 'bg-gray-100 text-gray-500']}>
            <Briefcase size={14} aria-hidden="true" />
            {company.jobsCount} açık ilan
          </span>
        )
      }
      <span class:list={['flex items-center gap-1 rounded-lg px-2.5 py-1.5', company.eventsCount > 0 ? 'bg-purple-50 text-purple-700' : 'bg-gray-100 text-gray-500']}>
        <CalendarDays size={14} aria-hidden="true" />
        {company.eventsCount} etkinlik
      </span>
      {
        !isClub && company.employeeRange && (
          <span class="flex items-center gap-1 rounded-lg bg-gray-100 px-2.5 py-1.5 text-gray-600">
            <Users size={14} aria-hidden="true" />
            {company.employeeRange}
          </span>
        )
      }
    </div>
  </div>
</article>
