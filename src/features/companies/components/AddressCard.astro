---
/**
 * [MODÜL: PROFİL ADRES KARTI]
 * Amaç: Genel bakış kenar çubuğunda şirket/kulübün ilk adresini kompakt ve taranabilir biçimde göstermek.
 * Neden ayrı bileşen: Konumlar sekmesi eklenince adres gösterimi profil sayfasından ayrıldı;
 *                     genel bakışta yalnızca ilk konum özetlenir, tam liste ayrı sekmede kalır.
 * Adres yoksa hiçbir şey çizilmez.
 */
import { ArrowUpRight, MapPin } from '@/shared/ui';
import { ROUTES } from '@/config/site';
import type { CompanyProfile } from '../types';

interface Props {
  addresses: CompanyProfile['addresses'];
  companySlug: string;
}

const { addresses, companySlug } = Astro.props;
const address = addresses[0];
---

{
  address && (
    <section class="rounded-[1.65rem] border border-slate-200/80 bg-white p-5 shadow-card sm:p-6" aria-labelledby="address-title">
      <div class="flex items-start gap-3.5">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-primary-50 text-primary-700">
          <MapPin size={19} strokeWidth={1.8} aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">Konum</p>
              <h2 id="address-title" class="mt-0.5 font-extrabold text-slate-950">{address.title || 'Merkez adresi'}</h2>
            </div>
            {addresses.length > 1 && <span class="rounded-lg bg-slate-100 px-2 py-1 text-[10px] font-black text-slate-500">{addresses.length} lokasyon</span>}
          </div>

          {address.address && <p class="mt-2 break-words text-sm leading-6 text-slate-600">{address.address}</p>}

          <a
            href={ROUTES.companyLocations(companySlug)}
            class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-primary-700 hover:text-primary-800 hover:underline focus-visible:rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
          >
            {addresses.length > 1 ? 'Tüm konumları gör' : 'Haritada gör'}
            <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  )
}
