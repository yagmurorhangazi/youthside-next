---
/**
 * [MODÜL: ŞİRKET / KULÜP PROFİL ŞABLONU]
 * Amaç: Profilin tüm sekmelerinde ortak kapak, kimlik bilgileri ve sekme menüsünü çizmek.
 * Referans: youthside-2026-ui (yeni-is-veren-header) → sirket-profili/_profile-header.php
 *
 * Tasarım (referansla aynı): Kapak kreatifi kendi kartında kırpılmadan (3:1, contain) gösterilir ve
 * üstüne hiçbir UI bindirilmez; logo kapağın alt kenarına taşar, kimlik şeridi ve sekmeler logonun
 * sağında hizalanır. Mobilde aynı işaretleme tek sütuna iner (ayrı mobil kopya yok → DRY).
 *
 * Sekmeler veriyle tanımlanır (OCP). Kulüplerde "İlanlar" sekmesi yoktur (kulüpler ilan açamaz);
 * içerik olmayan Ödüller/Fotoğraflar/Konumlar sekmeleri gizlenir. İlan/etkinlik sayısı referanstaki
 * gibi 0 olsa da gösterilir.
 */
import {
  BadgeCheck,
  BriefcaseBusiness,
  Building2,
  CalendarDays,
  ExternalLink,
  GraduationCap,
  Images,
  MapPin,
  Sparkles,
  Trophy,
  Users,
  type LucideIcon,
} from 'lucide-react';
import { ROUTES } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/shared/ui/Breadcrumbs.astro';
import CompanyLogo from '@/shared/ui/CompanyLogo.astro';
import Container from '@/shared/ui/Container.astro';
import type { ProfileContext, ProfileTab } from '../lib/profile-loader';
import SocialLinks from './SocialLinks.astro';

interface Props {
  context: ProfileContext;
  active: ProfileTab;
  /** Sekmeye özel sayfa başlığı (ör. "İlanlar"). Genel bakışta verilmez. */
  title?: string;
  description?: string;
  /** Genel bakışta kurum bilgileri sağ kolonda gösterildiğinde başlıktaki tekrarları kaldırır. */
  detailsInSidebar?: boolean;
}

const { context, active, title, description, detailsInSidebar = false } = Astro.props;
const { profile, counts } = context;
const isClub = profile.type === 'club';
const directory = isClub ? { label: 'Kulüpler', href: ROUTES.clubs } : { label: 'Şirketler', href: ROUTES.companies };

interface Tab {
  key: ProfileTab;
  label: string;
  href: string;
  visible: boolean;
  count?: number;
  icon: LucideIcon;
}

const tabs = (
  [
    { key: 'overview', label: isClub ? 'Kulüp hakkında' : 'Hakkımızda', href: ROUTES.company(profile.slug), visible: true, icon: Sparkles },
    { key: 'jobs', label: 'İlanlar', count: counts.jobs, href: ROUTES.companyJobs(profile.slug), visible: !isClub, icon: BriefcaseBusiness },
    { key: 'events', label: 'Etkinlikler', count: counts.events, href: ROUTES.companyEvents(profile.slug), visible: true, icon: CalendarDays },
    { key: 'awards', label: 'Ödüller', href: ROUTES.companyAwards(profile.slug), visible: counts.awards > 0, icon: Trophy },
    { key: 'photos', label: 'Fotoğraflar', href: ROUTES.companyPhotos(profile.slug), visible: counts.photos > 0, icon: Images },
    { key: 'locations', label: 'Konumlar', href: ROUTES.companyLocations(profile.slug), visible: counts.locations > 0, icon: MapPin },
  ] satisfies Tab[]
).filter((tab) => tab.visible);

/** Geniş ekranda sağda gösterilen kısa bilgiler; boş değerler atlanır. */
const facts = (
  isClub
    ? [{ label: 'Üniversite', value: profile.university, icon: GraduationCap }]
    : [
        { label: 'Sektör', value: profile.sector, icon: Building2 },
        { label: 'Çalışan', value: profile.employeeRange, icon: Users },
      ]
).filter((fact): fact is { label: string; value: string; icon: LucideIcon } => !!fact.value);

const pageTitle = title ? `${profile.name} ${title}` : `${profile.name} — ${isClub ? 'Kulüp' : 'Kariyer'} Profili`;
const pageDescription =
  description ?? (profile.aboutText || `${profile.name} hakkında bilgi, açık ilanlar ve etkinlikler Youthside'da.`);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: profile.name,
  logo: profile.logoUrl ?? undefined,
  url: profile.website ?? undefined,
  sameAs: profile.socials.map((social) => social.url),
  description: profile.aboutText || undefined,
};

---

<BaseLayout title={pageTitle} description={pageDescription} image={profile.coverImageUrl ?? profile.logoUrl} schema={active === 'overview' ? organizationSchema : null} muted>
  <Container>
    <div class="pb-3 pt-4 sm:pt-5"><Breadcrumbs items={[directory, { label: profile.name }]} /></div>

    <section class="overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white shadow-lift md:rounded-[2rem]">
      <!-- Kapak: kreatif kırpılmaz, üstüne metin/buton bindirilmez -->
      {
        profile.coverImageUrl ? (
          <div class="aspect-3/1 w-full overflow-hidden bg-white">
            <img src={profile.coverImageUrl} alt={`${profile.name} kapak görseli`} fetchpriority="high" class="h-full w-full object-contain object-center" />
          </div>
        ) : (
          <div class="relative flex h-32 items-center justify-center overflow-hidden bg-linear-to-br from-slate-950 via-slate-900 to-primary-900 sm:h-44" aria-hidden="true">
            <div class="absolute inset-0 opacity-10 [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:20px_20px]"></div>
            <Building2 size={72} className="text-white/20" strokeWidth={1.25} />
          </div>
        )
      }

      <!-- Kimlik şeridi -->
      <div class="relative border-t border-slate-100 px-4 sm:px-6 md:min-h-28 md:pl-44">
        <CompanyLogo name={profile.name} src={profile.logoUrl} size="xl" class="relative -mt-12 ring-4 ring-white md:absolute md:left-6 md:-top-14 md:mt-0" />

        <div class="flex flex-col gap-4 pb-4 pt-3 md:py-5 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
          <div class="min-w-0">
            <p class="mb-1.5 flex items-center gap-1.5 text-[10px] font-black uppercase tracking-[0.14em] text-primary-600">
              {isClub ? <GraduationCap size={13} aria-hidden="true" /> : <Building2 size={13} aria-hidden="true" />}
              {isClub ? 'Öğrenci kulübü' : 'Şirket profili'}
            </p>
            <h1 class="flex items-center gap-2 text-2xl font-black leading-tight tracking-[-0.025em] text-slate-950 lg:text-[2rem]">
              <span class="min-w-0 break-words">{profile.name}</span>
              {profile.isVerified && <BadgeCheck size={24} className="shrink-0 text-blue-500" aria-label="Onaylı hesap" />}
            </h1>

            {!detailsInSidebar && (
              <div class="mt-3 flex flex-wrap gap-2 lg:hidden">
                {facts.map(({ icon: FactIcon, value }) => (
                  <span class="inline-flex min-h-8 items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 text-xs font-semibold text-slate-600">
                    <FactIcon size={14} className="text-primary-600" aria-hidden="true" />
                    {value}
                  </span>
                ))}
              </div>
            )}
          </div>

          {!detailsInSidebar && (
            <div class="flex flex-wrap items-center gap-2 lg:justify-end">
              <dl class="hidden items-center gap-2 lg:flex">
                {facts.map(({ label, value, icon: FactIcon }) => (
                  <div class="flex min-h-11 items-center gap-2.5 rounded-xl border border-slate-200 bg-slate-50/80 px-3.5">
                    <FactIcon size={17} className="shrink-0 text-primary-600" aria-hidden="true" />
                    <div>
                      <dt class="text-[9px] font-black uppercase tracking-[0.12em] text-slate-400">{label}</dt>
                      <dd class="max-w-36 truncate text-xs font-bold text-slate-800" title={value}>{value}</dd>
                    </div>
                  </div>
                ))}
              </dl>
              <SocialLinks socials={profile.socials} companyName={profile.name} />
              {profile.website && (
                <a
                  href={profile.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-slate-950 px-4 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800"
                >
                  Web sitesi
                  <ExternalLink size={15} aria-hidden="true" />
                </a>
              )}
            </div>
          )}
        </div>
      </div>

      <!-- Sekmeler -->
      <nav aria-label="Profil bölümleri" class="border-t border-slate-100 bg-slate-50/70 px-2 py-2 sm:px-4 md:pl-44">
        <ul class="scrollbar-none flex gap-1 overflow-x-auto">
          {
            tabs.map((tab) => {
              const isActive = tab.key === active;
              const Icon = tab.icon;
              return (
                <li class="shrink-0">
                  <a
                    href={tab.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center gap-2 whitespace-nowrap rounded-xl px-3 text-sm font-bold transition',
                      isActive ? 'bg-white text-primary-700 shadow-sm ring-1 ring-slate-200/70' : 'text-slate-500 hover:bg-white/70 hover:text-slate-900',
                    ]}
                  >
                    <Icon size={16} aria-hidden="true" />
                    {tab.label}
                    {typeof tab.count === 'number' && (
                      <span class:list={['rounded-md px-1.5 py-0.5 text-[10px] font-black', isActive ? 'bg-primary-50 text-primary-700' : 'bg-slate-200/70 text-slate-500']}>
                        {tab.count}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </section>

    <div class="py-8 md:py-12">
      <slot />
    </div>
  </Container>
</BaseLayout>
