---
/**
 * [MODÜL: ŞİRKET / KULÜP PROFİL ŞABLONU]
 * Amaç: Profilin tüm sekmelerinde ortak kapak, kimlik bilgileri ve sekme menüsünü çizmek.
 * Referans: youthside-2026-ui (yeni-is-veren-header) → sirket-profili/_profile-header.php
 *
 * Tasarım: Kapak kreatifi kendi kartında kırpılmadan (3:1, contain) gösterilir ve üstüne hiçbir UI
 * bindirilmez. Logo kapağın alt kenarına taşar; şirket adı, kısa bilgiler ve sosyal hesaplar aynı
 * kimlik şeridinde toplanır. Sekmeler referanstaki sade alt çizgi düzenini kullanır.
 * Mobilde aynı işaretleme tek sütuna iner (ayrı mobil kopya yok → DRY).
 *
 * Sekmeler veriyle tanımlanır (OCP). Kulüplerde "İlanlar" sekmesi yoktur (kulüpler ilan açamaz);
 * içerik olmayan Ödüller/Fotoğraflar/Konumlar sekmeleri gizlenir. İlan/etkinlik sayısı referanstaki
 * gibi 0 olsa da gösterilir.
 */
import { BadgeCheck, Building2 } from 'lucide-react';
import { ROUTES } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CompanyLogo from '@/shared/ui/CompanyLogo.astro';
import Container from '@/shared/ui/Container.astro';
import type { ProfileContext, ProfileTab } from '../lib/profile-loader';
import SocialLinks from './SocialLinks.astro';

interface Props {
  context: ProfileContext;
  active: ProfileTab;
  /** Sekmeye özel sayfa başlığı (ör. "İlanlar"). Genel bakışta verilmez. */
  title?: string;
  description?: string;
}

const { context, active, title, description } = Astro.props;
const { profile, counts } = context;
const isClub = profile.type === 'club';

interface Tab {
  key: ProfileTab;
  label: string;
  href: string;
  visible: boolean;
  count?: number;
}

const tabs = (
  [
    { key: 'overview', label: isClub ? 'Kulüp Hakkında' : 'Şirket Kültürümüz', href: ROUTES.company(profile.slug), visible: true },
    { key: 'jobs', label: 'İlanlarımız', count: counts.jobs, href: ROUTES.companyJobs(profile.slug), visible: !isClub },
    { key: 'events', label: 'Etkinliklerimiz', count: counts.events, href: ROUTES.companyEvents(profile.slug), visible: true },
    { key: 'awards', label: 'Ödüllerimiz', href: ROUTES.companyAwards(profile.slug), visible: counts.awards > 0 },
    { key: 'photos', label: 'Fotoğraflar', href: ROUTES.companyPhotos(profile.slug), visible: counts.photos > 0 },
    { key: 'locations', label: 'Konumlarımız', href: ROUTES.companyLocations(profile.slug), visible: counts.locations > 0 },
  ] satisfies Tab[]
).filter((tab) => tab.visible);

/** Kimlik şeridinde gösterilen kısa bilgiler; API'de boş gelen değerler yer kaplamaz. */
const facts = (
  isClub
    ? [{ label: 'Üniversite', value: profile.university }]
    : [
        { label: 'Çalışan', value: profile.employeeRange },
        { label: 'Sektör', value: profile.sector },
      ]
).filter((fact): fact is { label: string; value: string } => !!fact.value);

const pageTitle = title ? `${profile.name} ${title}` : `${profile.name} — ${isClub ? 'Kulüp' : 'Kariyer'} Profili`;
const pageDescription =
  description ?? (profile.aboutText || `${profile.name} hakkında bilgi, açık ilanlar ve etkinlikler Youthside'da.`);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: profile.name,
  logo: profile.logoUrl ?? undefined,
  url: profile.website ?? undefined,
  sameAs: profile.socials.map((social) => social.url),
  description: profile.aboutText || undefined,
};

---

<BaseLayout title={pageTitle} description={pageDescription} image={profile.coverImageUrl ?? profile.logoUrl} schema={active === 'overview' ? organizationSchema : null} muted>
  <Container class="pt-5 sm:pt-7">
    <section class="overflow-hidden rounded-[1.75rem] border border-slate-200/70 bg-white shadow-lift md:rounded-[2rem]">
      <!-- Kapak: kreatif kırpılmaz, üstüne metin/buton bindirilmez -->
      {
        profile.coverImageUrl ? (
          <div class="aspect-3/1 w-full overflow-hidden bg-white">
            <img src={profile.coverImageUrl} alt={`${profile.name} kapak görseli`} fetchpriority="high" class="h-full w-full object-contain object-center" />
          </div>
        ) : (
          <div class="relative flex h-32 items-center justify-center overflow-hidden bg-linear-to-br from-slate-950 via-slate-900 to-primary-900 sm:h-44" aria-hidden="true">
            <div class="absolute inset-0 opacity-10 [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:20px_20px]"></div>
            <Building2 size={72} className="text-white/20" strokeWidth={1.25} />
          </div>
        )
      }

      <!-- Kimlik şeridi -->
      <div class="relative border-t border-slate-100 px-4 sm:px-6 md:min-h-28 md:pl-44">
        <CompanyLogo name={profile.name} src={profile.logoUrl} size="xl" class="relative -mt-12 ring-4 ring-white md:absolute md:left-6 md:-top-12 md:mt-0" />

        <div class="flex flex-col gap-5 pb-5 pt-3 md:min-h-28 md:justify-center md:py-4 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
          <div class="min-w-0">
            <h1 class="flex items-center gap-2 text-2xl font-black leading-tight tracking-[-0.035em] text-slate-950 sm:text-[1.75rem]">
              <span class="min-w-0 break-words">{profile.name}</span>
              {profile.isVerified && <BadgeCheck size={24} className="shrink-0 text-blue-500" aria-label="Onaylı hesap" />}
            </h1>
          </div>

          {(facts.length > 0 || profile.socials.length > 0) && (
            <div class="flex w-full flex-wrap items-start gap-y-4 sm:w-auto lg:shrink-0 lg:items-center lg:justify-end">
              {facts.length > 0 && (
                <dl class="flex flex-wrap items-center">
                  {facts.map(({ label, value }, index) => (
                    <div class:list={['min-w-28 pr-5', index > 0 && 'border-l border-slate-200 pl-5']}>
                      <dt class="text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">{label}</dt>
                      <dd class="mt-1 max-w-40 truncate text-sm font-extrabold text-slate-800" title={value}>{value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {profile.socials.length > 0 && (
                <div class:list={['w-full border-t border-slate-200 pt-3 sm:w-auto sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0', facts.length === 0 && 'sm:border-l-0 sm:pl-0']}>
                  <p class="text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">Sosyal medya</p>
                  <SocialLinks socials={profile.socials} companyName={profile.name} class="mt-0.5" />
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      <!-- Sekmeler -->
      <nav aria-label="Profil bölümleri" class="border-t border-slate-100 px-2 sm:px-4 md:pl-44">
        <ul class="scrollbar-none flex gap-1 overflow-x-auto">
          {
            tabs.map((tab) => {
              const isActive = tab.key === active;
              return (
                <li class="shrink-0">
                  <a
                    href={tab.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'relative flex min-h-14 items-center gap-2 whitespace-nowrap px-3 text-sm font-bold transition-colors after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:origin-left after:bg-primary-600 after:transition-transform',
                      isActive
                        ? 'text-primary-700 after:scale-x-100'
                        : 'text-slate-500 after:scale-x-0 hover:text-slate-900 hover:after:scale-x-100',
                    ]}
                  >
                    {tab.label}
                    {typeof tab.count === 'number' && (
                      <span class:list={['rounded-md px-1.5 py-0.5 text-[10px] font-black', isActive ? 'bg-primary-50 text-primary-700' : 'bg-slate-100 text-slate-400']}>
                        {tab.count}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </section>

    <div class="py-8 md:py-12">
      <slot />
    </div>
  </Container>
</BaseLayout>
