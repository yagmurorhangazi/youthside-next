---
/**
 * [MODÜL: ANA SAYFA — SON EKLENEN İLANLAR]
 * Amaç: En yeni ilanları kart ızgarasında göstermek. Veri sayfadan prop olarak gelir.
 */
import { Inbox } from '@/shared/ui';
import { ROUTES } from '@/config/site';
import JobCard from '@/features/jobs/components/JobCard.astro';
import type { JobSummary } from '@/features/jobs/types';
import CardGrid from '@/shared/ui/CardGrid.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

interface Props {
  jobs: JobSummary[];
}

const { jobs } = Astro.props;
---

<section class="border-b border-gray-100 bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Son Eklenen İlanlar"
      description="Her gün güncellenen ve üniversite öğrencileri ile yeni mezunlara özel açılan en gözde staj ve iş ilanları."
      link={{ label: 'Tüm İlanları Gör', href: ROUTES.jobs }}
    />
    <CardGrid isEmpty={jobs.length === 0} emptyIcon={Inbox} emptyTitle="Şu an için yayında olan ilan bulunmamaktadır.">
      {jobs.map((job) => <JobCard job={job} />)}
    </CardGrid>
  </div>
</section>
