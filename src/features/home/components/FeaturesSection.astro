---
/**
 * [MODÜL: ANA SAYFA — NEDEN YOUTHSIDE?]
 * Amaç: Platformun üç temel faydasını bento kartlarla anlatmak.
 * OCP: Yeni kart eklemek için `content.ts`'deki FEATURES listesine kayıt eklemek yeterli.
 */
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { FEATURES, type FeatureTone } from '../content';

/** Ton → sınıf eşlemesi. Sınıflar tam yazılır; dinamik birleştirme Tailwind taramasını bozar. */
const toneClasses: Record<FeatureTone, { blob: string; icon: string }> = {
  primary: { blob: 'bg-primary-50', icon: 'bg-primary-100 text-primary-600 border-primary-200' },
  blue: { blob: 'bg-blue-50', icon: 'bg-blue-100 text-blue-600 border-blue-200' },
  purple: { blob: 'bg-purple-50', icon: 'bg-purple-100 text-purple-600 border-purple-200' },
};
---

<section class="bg-gray-50 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      align="center"
      eyebrow="Neden Youthside?"
      title="Kariyer Serüvenini Hızlandır"
      description="Youthside, geleneksel iş arama süreçlerini rafa kaldırıyor. Senin için en uygun fırsatları tek platformda topluyor."
    />

    <ul class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-8">
      {
        FEATURES.map(({ title, description, icon: Icon, tone }) => (
          <li class="group relative overflow-hidden rounded-3xl border border-gray-100 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-hover md:p-8">
            <div
              class:list={['absolute -right-8 -top-8 h-32 w-32 rounded-bl-full transition-transform group-hover:scale-110', toneClasses[tone].blob]}
              aria-hidden="true"
            />
            <div class:list={['relative mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border', toneClasses[tone].icon]}>
              <Icon size={28} aria-hidden="true" />
            </div>
            <h3 class="relative mb-3 text-xl font-bold text-gray-900">{title}</h3>
            <p class="relative leading-relaxed text-gray-600">{description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
