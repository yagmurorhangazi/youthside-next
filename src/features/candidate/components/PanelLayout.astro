---
/**
 * [MODÜL: ADAY PANELİ ŞABLONU]
 * Amaç: /panelim altındaki tüm sayfaların ortak iskeleti.
 *   - Masaüstü: solda kullanıcı kartı + dikey menü, sağda içerik
 *   - Mobil: üstte yatay kaydırılabilir sekme menüsü
 * Referans: youthside-2026-ui/panelim/index.php (sekmeli panel yapısı)
 * Erişim kontrolü middleware'dedir; buraya giriş yapmamış kullanıcı gelemez.
 */
import { LogOut } from 'lucide-react';
import { ACCOUNT_NAV, ROUTES } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UserAvatar, isPathActive } from '@/shared/ui';
import Container from '@/shared/ui/Container.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, heading = title, description } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;
/** "Panelim" yalnızca tam eşleşmede aktif olur; alt sayfalarda kendi sekmesi aktif. */
const isActive = (href: string) => (href === ROUTES.dashboard ? path === href || path === `${href}/` : isPathActive(href, path));
---

<BaseLayout title={title} noindex muted>
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-72 bg-gradient-to-b from-primary-50/70 to-transparent" aria-hidden="true"></div>
    <Container class="relative py-6 md:py-10">
    <div class="grid gap-6 lg:grid-cols-[272px_1fr] lg:gap-8">
      <!-- Kenar menüsü -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="hidden overflow-hidden rounded-[24px] border border-slate-100 bg-white shadow-[0_16px_45px_rgb(15_23_42/0.06)] lg:block">
          <div class="h-1.5 bg-gradient-to-r from-primary-700 via-primary-500 to-amber-400" aria-hidden="true"></div>
          <div class="flex items-center gap-3 border-b border-gray-100 p-5">
            <UserAvatar name={user.name} src={user.avatarUrl} size="lg" online />
            <div class="min-w-0">
              <p class="mb-0.5 text-[10px] font-extrabold uppercase tracking-wider text-primary-600">Aday hesabı</p>
              <p class="truncate font-bold text-gray-900">{user.name}</p>
              <p class="truncate text-xs text-gray-500">{user.email}</p>
            </div>
          </div>
          <nav aria-label="Panel menüsü" class="p-4">
            <ul class="space-y-1">
              {
                ACCOUNT_NAV.map(({ label, href, icon: Icon }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={isActive(href) ? 'page' : undefined}
                      class:list={[
                        'flex min-h-11 items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition',
                        isActive(href) ? 'bg-primary-700 text-white shadow-lg shadow-primary-700/10' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900',
                      ]}
                    >
                      <Icon size={18} aria-hidden="true" />
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <form method="post" action={ROUTES.logout} class="border-t border-gray-100 p-4">
            <button type="submit" class="flex min-h-11 w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-red-500 transition hover:bg-red-50">
              <LogOut size={18} aria-hidden="true" />
              Çıkış yap
            </button>
          </form>
        </div>

        <!-- Mobil sekme menüsü -->
        <nav aria-label="Panel menüsü" class="-mx-4 lg:hidden">
          <ul class="scrollbar-none flex gap-2 overflow-x-auto px-4">
            {
              ACCOUNT_NAV.map(({ label, href, icon: Icon }) => (
                <li class="shrink-0">
                  <a
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                    class:list={[
                      'flex h-11 items-center gap-2 rounded-xl border px-4 text-sm font-semibold shadow-sm',
                      isActive(href) ? 'border-primary-700 bg-primary-700 text-white' : 'border-gray-200 bg-white text-gray-700',
                    ]}
                  >
                    <Icon size={16} aria-hidden="true" />
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <!-- İçerik -->
      <div class="min-w-0">
        <header class="mb-6 rounded-[24px] border border-white/80 bg-white/85 px-5 py-5 shadow-card backdrop-blur-sm sm:px-6">
          <p class="mb-1.5 text-[11px] font-extrabold uppercase tracking-[0.16em] text-primary-600">Aday paneli</p>
          <h1 class="text-2xl font-black tracking-tight text-gray-900 md:text-3xl">{heading}</h1>
          {description && <p class="mt-1.5 max-w-2xl text-sm leading-6 text-gray-600 sm:text-base">{description}</p>}
        </header>
        <slot />
      </div>
    </div>
    </Container>
  </div>
</BaseLayout>
