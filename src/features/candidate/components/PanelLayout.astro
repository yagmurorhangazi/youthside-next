---
/**
 * [MODÜL: ADAY PANELİ ŞABLONU]
 * Amaç: /panelim altındaki tüm sayfaların ortak iskeleti.
 *   - Masaüstü: solda kullanıcı kartı + dikey menü, sağda içerik
 *   - Mobil: üstte yatay kaydırılabilir sekme menüsü
 * Referans: youthside-2026-ui/panelim/index.php (sekmeli panel yapısı)
 * Erişim kontrolü middleware'dedir; buraya giriş yapmamış kullanıcı gelemez.
 */
import { LogOut } from 'lucide-react';
import { ACCOUNT_NAV, ROUTES } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UserAvatar, isPathActive } from '@/shared/ui';
import Container from '@/shared/ui/Container.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, heading = title, description } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;
/** "Panelim" yalnızca tam eşleşmede aktif olur; alt sayfalarda kendi sekmesi aktif. */
const isActive = (href: string) => (href === ROUTES.dashboard ? path === href || path === `${href}/` : isPathActive(href, path));
---

<BaseLayout title={title} noindex muted>
  <div class="min-w-0 bg-slate-50/70">
    <Container class="py-6 md:py-10">
    <div class="grid items-start gap-6 lg:grid-cols-[232px_minmax(0,1fr)] lg:gap-8">
      <!-- Kenar menüsü -->
      <aside class="lg:self-start">
        <div class="hidden border-r border-slate-200 pr-5 lg:block">
          <div class="flex items-center gap-3 px-2 pb-5">
            <UserAvatar name={user.name} src={user.avatarUrl} size="lg" online />
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-slate-950">{user.name}</p>
              <p class="mt-0.5 truncate text-[11px] text-slate-400">{user.email}</p>
            </div>
          </div>
          <nav aria-label="Panel menüsü">
            <p class="px-2 pb-2 text-[10px] font-semibold uppercase tracking-[0.13em] text-slate-400">Hesabım</p>
            <ul class="space-y-1">
              {
                ACCOUNT_NAV.map(({ label, href, icon: Icon }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={isActive(href) ? 'page' : undefined}
                      class:list={[
                        'group flex min-h-11 items-center gap-3 rounded-xl px-2.5 text-sm font-medium transition',
                        isActive(href) ? 'bg-white text-slate-950 shadow-sm ring-1 ring-slate-200/70' : 'text-slate-500 hover:bg-white/70 hover:text-slate-950',
                      ]}
                    >
                      <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg transition', isActive(href) ? 'bg-primary-50 text-primary-700' : 'text-slate-400 group-hover:text-primary-700']}>
                        <Icon size={16} strokeWidth={2} aria-hidden="true" />
                      </span>
                      <span class="flex-1">{label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <form method="post" action={ROUTES.logout} class="mt-5 border-t border-slate-200 pt-3">
            <button type="submit" class="flex min-h-10 w-full items-center gap-3 rounded-xl px-2.5 text-sm font-medium text-red-500 transition hover:bg-red-50">
              <span class="flex h-7 w-7 items-center justify-center"><LogOut size={16} aria-hidden="true" /></span>
              Çıkış yap
            </button>
          </form>
        </div>

        <!-- Mobil sekme menüsü -->
        <nav aria-label="Panel menüsü" class="-mx-4 lg:hidden">
          <ul class="scrollbar-none flex gap-2 overflow-x-auto px-4 pb-1">
            {
              ACCOUNT_NAV.map(({ label, href, icon: Icon }) => (
                <li class="shrink-0">
                  <a
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                    class:list={[
                      'flex h-10 items-center gap-2 rounded-xl border px-3.5 text-sm font-medium transition',
                      isActive(href) ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-200 bg-white text-slate-600',
                    ]}
                  >
                    <Icon size={16} aria-hidden="true" />
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <!-- İçerik -->
      <div class="min-w-0">
        <header class="mb-7 border-b border-slate-200 pb-5">
          <h1 class="text-2xl font-extrabold tracking-[-0.025em] text-slate-950 md:text-3xl">{heading}</h1>
          {description && <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">{description}</p>}
        </header>
        <slot />
      </div>
    </div>
    </Container>
  </div>
</BaseLayout>
