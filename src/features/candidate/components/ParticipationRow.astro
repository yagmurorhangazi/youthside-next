---
/**
 * [MODÜL: BAŞVURU / KAYIT SATIRI]
 * Amaç: "Başvurularım" ve "Etkinliklerim" listelerinde tek bir kaydı yatay satır olarak göstermek.
 * Aynı görsel dili iki listede de kullanmak için ortak bileşen (DRY); içerik veriyle gelir.
 */
import { Building2, CalendarClock, ChevronRight } from '@/shared/ui';
import CompanyLogo from '@/shared/ui/CompanyLogo.astro';

export interface Props {
  href: string;
  title: string;
  companyName: string;
  companyLogo: string | null;
  /** Küçük gri bilgi satırı (ör. "Staj · Hibrit"). */
  meta?: string | null;
  /** Sağdaki tarih metni (ör. "3 gün önce başvurdun"). */
  dateText?: string | null;
  badge?: { label: string; tone: 'green' | 'gray' | 'orange' | 'blue' | 'red' };
}

const { href, title, companyName, companyLogo, meta, dateText, badge } = Astro.props;

const TONES = {
  green: 'bg-emerald-50 text-emerald-700',
  gray: 'bg-gray-100 text-gray-600',
  orange: 'bg-orange-50 text-orange-700',
  blue: 'bg-blue-50 text-blue-700',
  red: 'bg-red-50 text-red-600',
} as const;
---

<li>
  <a href={href} class="group flex min-h-24 items-center gap-3 rounded-[20px] border border-slate-200/70 bg-slate-50/40 p-3.5 transition hover:border-primary-200 hover:bg-white hover:shadow-[0_14px_35px_-25px_rgb(15_23_42/0.4)] sm:gap-4 sm:p-4">
    <CompanyLogo name={companyName} src={companyLogo} size="md" />
    <div class="min-w-0 flex-1">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <p class="line-clamp-1 font-semibold text-slate-950 transition-colors group-hover:text-primary-700">{title}</p>
        {badge && <span class:list={['shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold', TONES[badge.tone]]}>{badge.label}</span>}
      </div>
      <p class="mt-1 flex min-w-0 items-center gap-1.5 text-sm text-slate-500">
        <Building2 size={13} className="shrink-0 text-slate-400" aria-hidden="true" />
        <span class="truncate">{[companyName, meta].filter(Boolean).join(' · ')}</span>
      </p>
      {dateText && (
        <p class="mt-1.5 flex items-center gap-1.5 text-[11px] font-medium text-slate-400">
          <CalendarClock size={12} aria-hidden="true" /> {dateText}
        </p>
      )}
    </div>
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-slate-300 shadow-sm ring-1 ring-slate-200/70 transition group-hover:bg-primary-600 group-hover:text-white group-hover:ring-primary-600">
      <ChevronRight size={17} aria-hidden="true" />
    </span>
  </a>
</li>
