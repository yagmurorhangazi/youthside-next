---
/**
 * [MODÜL: ETKİNLİK KARTI]
 * Amaç: Bir etkinliği afiş, tarih, organizatör ve konum bilgisiyle listelemek.
 * SRP: Tarih/konum metinleri `event-display.ts`'de üretilir; kart yalnızca yerleşimden sorumludur.
 *
 * Tasarım kararları:
 *   - Etkinlik görselleri çoğunlukla kare/dikey afiş. Sabit 16:9 çerçevede afiş KIRPILMADAN
 *     (object-contain) gösterilir, boşluğu aynı görselin bulanık kopyası doldurur. Afişteki
 *     yazılar kesilmez ve tüm kartlar aynı yükseklikte kalır.
 *   - Çerçevede `overflow-hidden` + mutlak konumlu görsel: aspect-ratio'nun içerikle esnemesini önler.
 *   - Organizatör, afiş ile içerik arasında ayrı bir profil kartçığıyla öne çıkarılır.
 *   - Tarih ve konum aynı görsel dilde iki kısa bilgi satırı olarak sunulur.
 */
import { ArrowUpRight, CalendarDays } from 'lucide-react';
import { ROUTES } from '@/config/site';
import { formatDayMonth, isSameCalendarDay, parseDate } from '@/shared/lib/date';
import OrganizationAttribution from '@/shared/ui/OrganizationAttribution.astro';
import { getEventDateInfo, getEventLocationLabel } from '../lib/event-display';
import type { EventSummary } from '../types';

interface Props {
  event: EventSummary;
  hideCompany?: boolean;
  eager?: boolean;
}

const { event, hideCompany = false, eager = false } = Astro.props;
const date = getEventDateInfo(event);
const isOnline = event.locationType === 'Online';
const isEnded = date.phase === 'ended';
const locationLabel = getEventLocationLabel(event);
const href = ROUTES.eventDetail(event.company.slug, event.slug);
const companyHref = ROUTES.company(event.company.slug);
const start = parseDate(event.startDate);
const end = parseDate(event.endDate);
const startLabel = start ? formatDayMonth(start) : 'Yakında';
const endLabel = end && start && !isSameCalendarDay(start, end) ? formatDayMonth(end) : end ? 'Aynı gün' : start ? 'Tek gün' : 'Belirtilmedi';
---

<article class:list={['group relative flex h-full flex-col overflow-hidden rounded-[28px] border border-slate-200/80 bg-white shadow-card card-interactive focus-within:border-primary-300 focus-within:ring-4 focus-within:ring-primary-500/10', isEnded && 'opacity-80']}>
  <!-- Afiş -->
  <div class="relative mx-3 mt-3 aspect-video overflow-hidden rounded-[20px] bg-slate-100">
    {
      event.imageUrl ? (
        <>
          <img src={event.imageUrl} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" class="absolute inset-0 h-full w-full scale-125 object-cover opacity-70 blur-2xl saturate-150" />
          <img
            src={event.imageUrl}
            alt=""
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class:list={['absolute inset-0 h-full w-full object-contain media-zoom', isEnded && 'grayscale']}
          />
        </>
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-purple-100 via-blue-50 to-primary-100 text-purple-300" aria-hidden="true">
          <CalendarDays size={48} strokeWidth={1.5} />
        </div>
      )
    }
    <div class="absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-slate-950/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute right-3 top-3 flex flex-wrap gap-1.5">
      {isEnded && <span class="rounded-full bg-slate-900/85 px-3 py-1.5 text-[11px] font-semibold text-white backdrop-blur">Sona erdi</span>}
    </div>
  </div>

  {
    !hideCompany && (
      <div class="relative -mt-8 px-4">
        <OrganizationAttribution name={event.company.name} logoUrl={event.company.logoUrl} href={companyHref} label="Düzenleyen" />
      </div>
    )
  }

  <!-- İçerik -->
  <div class:list={['flex grow flex-col px-5 pb-5 text-center sm:px-6 sm:pb-6', hideCompany ? 'pt-5' : 'pt-4']}>
    <h3 class="line-clamp-2 text-xl font-extrabold leading-snug tracking-[-0.02em] text-slate-950 transition-colors group-hover:text-primary-700">
      {event.title}
    </h3>
    {event.excerpt && <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">{event.excerpt}</p>}
    {event.type && <span class="mx-auto mt-4 inline-flex min-h-8 items-center rounded-full border border-slate-200 bg-slate-50 px-3 text-xs font-semibold text-slate-700">{event.type}</span>}

    <div class="mt-auto grid grid-cols-3 divide-x divide-slate-200 pt-6">
      <div class="min-w-0 px-1.5">
        <span class="block text-[9px] font-semibold uppercase tracking-[0.08em] text-slate-400">Başlangıç</span>
        <strong class="mt-1 block truncate text-sm font-semibold text-slate-800">{startLabel}</strong>
      </div>
      <div class="min-w-0 px-1.5">
        <span class="block text-[9px] font-semibold uppercase tracking-[0.08em] text-slate-400">Bitiş</span>
        <strong class="mt-1 block truncate text-sm font-semibold text-slate-800">{endLabel}</strong>
      </div>
      <div class="min-w-0 px-1.5">
        <span class="block text-[9px] font-semibold uppercase tracking-[0.08em] text-slate-400">{isOnline ? 'Katılım' : 'Konum'}</span>
        <strong class="mt-1 block truncate text-sm font-semibold text-slate-800" title={locationLabel}>{locationLabel}</strong>
      </div>
    </div>

    <a href={href} class="relative z-20 mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-primary-600 px-5 text-sm font-semibold text-white shadow-lg shadow-primary-600/20 transition hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-500/25">
      Etkinliği incele
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>
</article>
