---
/**
 * [SAYFA: KAYIT OL]
 * Referans: youthside-2026-ui/kayit-ol/index.php · Veri: candidates/platform-register
 * ?redirect= değeri doğrulama sonrası girişte kullanılmak üzere giriş linkine taşınır.
 */
import { ROUTES, safeRedirect } from '@/config/site';
import AuthLayout from '@/features/auth/components/AuthLayout.astro';
import RegisterForm from '@/features/auth/components/RegisterForm';

const rawRedirect = Astro.url.searchParams.get('redirect');
const redirect = rawRedirect ? safeRedirect(rawRedirect) : null;
// Zaten girişliyse istenen sayfaya (ör. başvurulacak ilan) gidilir; bağlam kaybolmaz.
if (Astro.locals.user) return Astro.redirect(redirect ?? ROUTES.dashboard, 302);
---

<AuthLayout title="Kayıt Ol" heading="Ücretsiz hesabını oluştur" subheading="Bir dakikada kaydol, fırsatları kaçırma." socialIntent="register">
  <RegisterForm client:load redirect={redirect} />
</AuthLayout>
