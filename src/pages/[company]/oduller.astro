---
/**
 * [SAYFA: PROFİL — ÖDÜLLER SEKMESİ]
 * URL: /{slug}/oduller · Referans: youthside-2026-ui/sirket-profili/oduller/index.php
 * Veri: companies/get_award_blocks (profil yükleyicisinden gelir; ek istek yok).
 * Uzun metinler kartta kırpılır; tamamı "Detayları görüntüle" penceresinde okunur.
 */
import { Award as AwardIcon, Trophy } from 'lucide-react';
import AwardDetails from '@/features/companies/components/AwardDetails';
import ProfileLayout from '@/features/companies/components/ProfileLayout.astro';
import { awardPreview, hasAwardDetails } from '@/features/companies/lib/awards';
import { loadProfileContext } from '@/features/companies/lib/profile-loader';
import CardGrid from '@/shared/ui/CardGrid.astro';

const slug = Astro.params.company ?? '';
const context = await loadProfileContext(Astro.locals.services, slug);
if (!context) return Astro.rewrite('/404');
---

<ProfileLayout context={context} active="awards" title="Ödülleri" description={`${context.profile.name} şirketinin aldığı ödüller ve başarılar.`}>
  <CardGrid isEmpty={context.awards.length === 0} emptyIcon={Trophy} emptyTitle="Henüz ödül eklenmemiş">
    {
      context.awards.map((award) => (
        <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
          <div class="flex aspect-[4/3] items-center justify-center bg-linear-to-br from-amber-50 to-primary-50 p-6">
            {award.imageUrl ? (
              <img src={award.imageUrl} alt="" loading="lazy" class="h-full w-full object-contain" />
            ) : (
              <AwardIcon size={56} className="text-amber-400" aria-hidden="true" />
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h2 class="font-bold leading-snug text-gray-900">{award.title}</h2>
            {(award.givenBy || award.year) && <p class="mt-1 text-sm font-medium text-gray-500">{[award.givenBy, award.year].filter(Boolean).join(' · ')}</p>}
            {awardPreview(award) && <p class="mt-3 text-sm text-gray-600">{awardPreview(award)}</p>}
            {hasAwardDetails(award) && (
              <AwardDetails client:visible title={award.title} contentHtml={award.contentHtml} imageUrl={award.imageUrl} year={award.year} givenBy={award.givenBy} />
            )}
          </div>
        </article>
      ))
    }
  </CardGrid>
</ProfileLayout>
