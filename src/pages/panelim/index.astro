---
/**
 * [SAYFA: PANELİM — GENEL BAKIŞ]
 * Referans: youthside-2026-ui/panelim/index.php
 * Veri (paralel): candidates/profile-completeness · applications/my-list · registrations/my-events · jobs/recommended
 * Erişim: Middleware giriş yapmamış kullanıcıyı giriş sayfasına yönlendirir.
 */
import { CalendarCheck, CircleGauge, FileText, Sparkles } from 'lucide-react';
import { ROUTES } from '@/config/site';
import { createSafeLoader } from '@/core/safe';
import CompletenessCard from '@/features/candidate/components/CompletenessCard.astro';
import PanelLayout from '@/features/candidate/components/PanelLayout.astro';
import ParticipationRow from '@/features/candidate/components/ParticipationRow.astro';
import { applicationRow, registrationRow } from '@/features/candidate/lib/participation-display';
import JobCard from '@/features/jobs/components/JobCard.astro';

const { candidate, jobs } = Astro.locals.services;
const user = Astro.locals.user!;
const safe = createSafeLoader('PANEL');

const [completeness, activeApps, events, recommended] = await Promise.all([
  safe(candidate.getCompleteness(), 'Profil doluluğu'),
  safe(candidate.myApplications('active', 1, 3), 'Başvurular'),
  safe(candidate.myEvents(1, 3), 'Etkinlikler'),
  safe(jobs.recommended(3), 'Öneriler'),
]);

const firstName = user.name.split(' ')[0];
const stats = [
  { label: 'Aktif başvuru', description: 'Devam eden süreç', value: activeApps?.total ?? 0, href: ROUTES.myApplications, icon: FileText, tone: 'text-blue-600' },
  { label: 'Etkinlik kaydı', description: 'Katılım planı', value: events?.total ?? 0, href: ROUTES.myEvents, icon: CalendarCheck, tone: 'text-violet-600' },
  { label: 'Profil doluluğu', description: completeness?.isEligible ? 'Başvuruya hazır' : 'Güncellemen gerekiyor', value: `%${completeness?.percentage ?? 0}`, href: ROUTES.profile, icon: CircleGauge, tone: 'text-emerald-600' },
];
const box = 'rounded-[20px] border border-slate-200/70 bg-white p-5 shadow-card sm:p-6';
---

<PanelLayout title="Panelim" heading={`Merhaba ${firstName}`} description="Başvurularını, etkinliklerini ve profilini buradan yönet.">
  <div class="space-y-6">
    <section aria-label="Kariyer özeti">
      <div class="grid overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm sm:grid-cols-3 sm:divide-x sm:divide-slate-200">
        {
          stats.map(({ label, description, value, href, icon: Icon, tone }) => (
            <a href={href} class="group flex min-w-0 items-center gap-3 border-b border-slate-200 px-4 py-4 transition last:border-b-0 hover:bg-slate-50 sm:border-b-0">
              <span class:list={['shrink-0', tone]}>
                <Icon size={19} strokeWidth={2} aria-hidden="true" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline gap-2">
                  <strong class="text-lg font-bold tracking-tight text-slate-950">{value}</strong>
                  <span class="truncate text-xs font-semibold text-slate-700">{label}</span>
                </span>
                <span class="block truncate text-[11px] text-slate-400">{description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {completeness && <CompletenessCard completeness={completeness} />}

    <div class="grid gap-6 xl:grid-cols-2">
      <section class={box} aria-labelledby="recent-apps">
        <div class="mb-5 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600"><FileText size={19} aria-hidden="true" /></span>
            <div><h2 id="recent-apps" class="font-bold text-gray-900">Son başvurularım</h2><p class="text-xs text-gray-400">Güncel başvuru hareketlerin</p></div>
          </div>
          <a href={ROUTES.myApplications} class="text-sm font-bold text-primary-600 hover:underline">Tümünü gör</a>
        </div>
        {
          activeApps && activeApps.items.length > 0 ? (
            <ul class="space-y-3">{activeApps.items.map((item) => <ParticipationRow {...applicationRow(item)} />)}</ul>
          ) : (
            <p class="rounded-2xl bg-gray-50 p-5 text-sm text-gray-500">
              Henüz aktif başvurun yok. <a href={ROUTES.jobs} class="font-bold text-primary-600 hover:underline">İlanlara göz at</a>
            </p>
          )
        }
      </section>

      <section class={box} aria-labelledby="my-events">
        <div class="mb-5 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-50 text-purple-600"><CalendarCheck size={19} aria-hidden="true" /></span>
            <div><h2 id="my-events" class="font-bold text-gray-900">Etkinliklerim</h2><p class="text-xs text-gray-400">Yaklaşan katılım planların</p></div>
          </div>
          <a href={ROUTES.myEvents} class="text-sm font-bold text-primary-600 hover:underline">Tümünü gör</a>
        </div>
        {
          events && events.items.length > 0 ? (
            <ul class="space-y-3">{events.items.map((item) => <ParticipationRow {...registrationRow(item)} />)}</ul>
          ) : (
            <p class="rounded-2xl bg-gray-50 p-5 text-sm text-gray-500">
              Henüz bir etkinliğe kaydolmadın. <a href={ROUTES.events} class="font-bold text-primary-600 hover:underline">Etkinlikleri keşfet</a>
            </p>
          )
        }
      </section>
    </div>

    {
      recommended && recommended.length > 0 && (
        <section aria-labelledby="recommended-title" class="pt-2">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div><h2 id="recommended-title" class="flex items-center gap-2 text-xl font-black text-gray-900"><Sparkles size={20} className="text-primary-500" aria-hidden="true" />Senin için önerilen ilanlar</h2><p class="mt-1 text-sm text-gray-500">Profil bilgilerine göre öne çıkan fırsatlar.</p></div>
            <a href={ROUTES.jobs} class="hidden text-sm font-bold text-primary-600 hover:underline sm:block">Tüm ilanlar</a>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 2xl:grid-cols-3">{recommended.map((job) => <JobCard job={job} />)}</div>
        </section>
      )
    }
  </div>
</PanelLayout>
