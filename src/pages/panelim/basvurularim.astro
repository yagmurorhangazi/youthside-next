---
/**
 * [SAYFA: PANELİM — BAŞVURULARIM]
 * Veri: applications/my-list?status_filter=active|past (sayfalı)
 * ?durum=gecmis → kapanmış ilanlar ve tamamlanmış süreçler.
 */
import { ArrowRight, BriefcaseBusiness, Clock3, FileCheck2, FileText } from '@/shared/ui';
import { ROUTES } from '@/config/site';
import { createSafeLoader } from '@/core/safe';
import PanelLayout from '@/features/candidate/components/PanelLayout.astro';
import ParticipationRow from '@/features/candidate/components/ParticipationRow.astro';
import { applicationRow } from '@/features/candidate/lib/participation-display';
import { getPage } from '@/shared/lib/search-params';
import CardGrid from '@/shared/ui/CardGrid.astro';
import ErrorNotice from '@/shared/ui/ErrorNotice.astro';
import PaginationNav from '@/shared/ui/PaginationNav.astro';

const isPast = Astro.url.searchParams.get('durum') === 'gecmis';
const result = await createSafeLoader('BASVURULARIM')(
  Astro.locals.services.candidate.myApplications(isPast ? 'past' : 'active', getPage(Astro.url.searchParams)),
  'Başvurular',
);

const tabs = [
  { label: 'Aktif süreçler', href: ROUTES.myApplications, active: !isPast, icon: Clock3 },
  { label: 'Geçmiş başvurular', href: `${ROUTES.myApplications}?durum=gecmis`, active: isPast, icon: FileCheck2 },
];
const total = result?.total ?? 0;
---

<PanelLayout title="Başvurularım" description="Yaptığın tüm ilan başvurularını buradan takip edebilirsin.">
  <section class="mb-6 border-b border-slate-200 pb-5" aria-label="Başvuru özeti ve filtreleri">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-primary-50 text-primary-700">
          <BriefcaseBusiness size={21} aria-hidden="true" />
        </span>
        <div>
          <p class="text-2xl font-extrabold tracking-tight text-slate-950">{total}</p>
          <p class="text-sm font-medium text-slate-500">{isPast ? 'geçmiş başvuru' : 'aktif başvuru süreci'}</p>
        </div>
      </div>
      <a href={ROUTES.jobs} class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-primary-600 px-4 text-sm font-semibold text-white transition hover:bg-primary-700">
        Yeni fırsatları keşfet <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>

    <nav aria-label="Başvuru durumu" class="mt-5 flex gap-6 overflow-x-auto">
      {
        tabs.map(({ label, href, active, icon: Icon }) => (
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={['relative flex min-h-10 shrink-0 items-center justify-center gap-2 border-b-2 px-0.5 text-center text-sm font-medium transition', active ? 'border-primary-600 text-slate-950' : 'border-transparent text-slate-500 hover:text-slate-900']}
          >
            <Icon size={16} className={active ? 'text-primary-600' : 'text-slate-400'} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </nav>
  </section>

  {
    result === null ? (
      <ErrorNotice />
    ) : result.items.length === 0 ? (
      <CardGrid
        isEmpty
        emptyIcon={FileText}
        emptyTitle={isPast ? 'Geçmiş başvurun bulunmuyor' : 'Henüz aktif başvurun yok'}
        emptyDescription="Sana uygun ilanları keşfet ve profilinle tek tıkla başvur."
        emptyAction={{ label: 'İlanları keşfet', href: ROUTES.jobs }}
      />
    ) : (
      <section aria-labelledby="application-list-title">
        <div class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600"><FileText size={17} aria-hidden="true" /></span>
          <div>
            <h2 id="application-list-title" class="font-semibold text-slate-900">{isPast ? 'Geçmiş başvurular' : 'Devam eden süreçler'}</h2>
            <p class="text-xs text-slate-400">Başvuru ayrıntısını görmek için ilana dokun.</p>
          </div>
        </div>
        <ul class="space-y-2.5">{result.items.map((item) => <ParticipationRow {...applicationRow(item)} />)}</ul>
        <PaginationNav page={result.page} totalPages={result.totalPages} url={Astro.url} />
      </section>
    )
  }
</PanelLayout>
