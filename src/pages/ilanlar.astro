---
/**
 * [SAYFA: İLANLAR]
 * Amaç: Yayındaki tüm staj ve iş ilanlarını arama, filtre, sıralama ve sayfalama ile listelemek.
 * Referans: youthside-2026-ui/ilanlar/index.php
 * Veri: GET jobs/list + filtre seçenekleri (data/job-types, data/work-models, locations/tr_cities)
 *
 * Filtre durumu URL'dedir; sayfa her istekte sunucuda render edilir (SEO + paylaşılabilir link).
 */
import { Inbox } from 'lucide-react';
import FilterBar from '@/components/filters/FilterBar';
import { ROUTES } from '@/config/site';
import JobCard from '@/features/jobs/components/JobCard.astro';
import { JOB_PARAMS, JOB_SORTS, parseJobFilters } from '@/features/jobs/lib/job-filters';
import { createSafeLoader } from '@/core/safe';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CardGrid from '@/shared/ui/CardGrid.astro';
import Container from '@/shared/ui/Container.astro';
import ErrorNotice from '@/shared/ui/ErrorNotice.astro';
import PageHeader from '@/shared/ui/PageHeader.astro';
import PaginationNav from '@/shared/ui/PaginationNav.astro';

const { jobs, lookups } = Astro.locals.services;
const { filters, values, sortKey } = parseJobFilters(Astro.url.searchParams);

const safe = createSafeLoader('ILANLAR');
const [result, types, workModels, cities] = await Promise.all([
  safe(jobs.list(filters), 'İlan listesi'),
  lookups.jobTypes(),
  lookups.workModels(),
  lookups.cities(),
]);

const groups = [
  { key: JOB_PARAMS.types, label: 'Çalışma tipi', options: types, icon: 'briefcase' as const },
  { key: JOB_PARAMS.workModels, label: 'Çalışma modeli', options: workModels, icon: 'house' as const },
  { key: JOB_PARAMS.locations, label: 'Şehir', options: cities, icon: 'map-pin' as const },
].filter((group) => group.options.length > 0);

const hasFilters = Boolean(filters.q) || Object.values(values).some((list) => list.length > 0);
---

<BaseLayout
  title="Staj ve İş İlanları"
  description="Türkiye'nin önde gelen şirketlerindeki güncel staj, yeni mezun ve iş ilanlarını keşfet; şehir ve çalışma modeline göre filtrele."
>
  <PageHeader
    eyebrow="Kariyer fırsatları"
    title="Staj ve iş ilanları"
    description="Kariyerine uygun fırsatı keşfet, ayrıntıları incele ve başvurunu kolayca tamamla."
    breadcrumbs={[{ label: 'İlanlar' }]}
  >
    <FilterBar
      client:idle
      basePath={ROUTES.jobs}
      searchPlaceholder="Pozisyon veya şirket ara"
      groups={groups}
      sorts={JOB_SORTS}
      initial={{ q: filters.q, values, sort: sortKey }}
      total={result?.total ?? 0}
      resultNoun="ilan"
    />
  </PageHeader>

  <section class="bg-slate-50/60" aria-label="İlan sonuçları">
    <Container class="py-10 md:py-14">
      {
        result === null ? (
          <ErrorNotice />
        ) : (
          <>
            <CardGrid
              isEmpty={result.items.length === 0}
              emptyIcon={Inbox}
              emptyTitle={hasFilters ? 'Aramana uygun ilan bulunamadı' : 'Şu an yayında ilan yok'}
              emptyDescription={hasFilters ? 'Filtreleri azaltmayı veya farklı bir anahtar kelime denemeyi düşünebilirsin.' : 'Yeni ilanlar eklendiğinde burada görünecek.'}
              emptyAction={hasFilters ? { label: 'Filtreleri temizle', href: ROUTES.jobs } : undefined}
            >
              {result.items.map((job, index) => <JobCard job={job} eager={index < 3} />)}
            </CardGrid>
            <PaginationNav page={result.page} totalPages={result.totalPages} url={Astro.url} />
          </>
        )
      }
    </Container>
  </section>
</BaseLayout>
