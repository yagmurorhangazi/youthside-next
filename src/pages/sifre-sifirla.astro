---
/**
 * [SAYFA: ŞİFRE SIFIRLA]
 * Referans: youthside-2026-ui/sifre-sifirla/index.php
 * E-postadaki bağlantı: /sifre-sifirla?token=…
 * Token sunucuda önce doğrulanır (auth/validate-reset-token); geçersizse form hiç gösterilmez.
 */
import { ROUTES } from '@/config/site';
import AuthLayout from '@/features/auth/components/AuthLayout.astro';
import { ResetPasswordForm } from '@/features/auth/components/PasswordResetForms';
import { ApiError } from '@/shared/api/errors';

const token = Astro.url.searchParams.get('token')?.trim() ?? '';
let email: string | null = null;
let problem: string | null = token ? null : 'Şifre sıfırlama bağlantısı eksik veya hatalı.';

if (token) {
  try {
    email = await Astro.locals.services.auth.validateResetToken(token);
  } catch (error) {
    problem = error instanceof ApiError && !error.isNetworkError ? error.message : 'Bağlantı şu an doğrulanamadı. Lütfen biraz sonra tekrar dene.';
  }
}
---

<AuthLayout title="Şifre Sıfırla" heading="Yeni şifre belirle" subheading={email ? `${email} hesabı için yeni şifreni oluştur.` : undefined}>
  {
    email && !problem ? (
      <ResetPasswordForm client:load token={token} email={email} />
    ) : (
      <div role="alert" class="rounded-3xl border border-amber-200 bg-amber-50 p-6">
        <p class="font-bold text-amber-900">Bağlantı kullanılamıyor</p>
        <p class="mt-2 text-sm text-amber-800">{problem}</p>
        <a href={ROUTES.forgotPassword} class="mt-5 inline-block rounded-full bg-gray-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-gray-700">
          Yeni bağlantı iste
        </a>
      </div>
    )
  }
</AuthLayout>
