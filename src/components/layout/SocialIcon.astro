---
/**
 * [MODÜL: SOSYAL MEDYA İKONU]
 * Amaç: Footer ve kurum profillerindeki marka ikonlarını React Icons kataloğundan çizmek.
 * Neden: Marka sembollerinin elle tutulan SVG yolları yerine doğrulanmış Font Awesome sürümleri
 *        kullanılır; yeni platform yalnızca veri eşlemesine eklenir (OCP).
 */
import type { IconType } from 'react-icons';
import { FaFacebookF, FaInstagram, FaLinkedinIn, FaTiktok, FaXTwitter, FaYoutube } from 'react-icons/fa6';
import type { SocialPlatform } from '@/features/companies/types';

interface Props {
  platform: SocialPlatform;
  class?: string;
}

const icons: Record<SocialPlatform, IconType> = {
  instagram: FaInstagram,
  linkedin: FaLinkedinIn,
  twitter: FaXTwitter,
  facebook: FaFacebookF,
  youtube: FaYoutube,
  tiktok: FaTiktok,
};

const { platform, class: className = 'h-4 w-4' } = Astro.props;
const Icon = icons[platform];
---

<Icon className={className} aria-hidden="true" />
