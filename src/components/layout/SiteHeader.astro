---
/**
 * [MODÜL: SİTE HEADER]
 * Amaç: Logo, masaüstü menü ve kullanıcı/misafir aksiyonlarını içeren yapışkan üst bar.
 *
 * Mimari: Statik kısımlar Astro'da (sıfır JS) render edilir. Yalnızca etkileşimli parçalar
 *         (mobil çekmece, kullanıcı menüsü) React island olarak hydrate edilir.
 * SRP: Header oturumu kendisi okumaz; `user` bilgisini layout'tan alır.
 */
import { MAIN_NAV, ROUTES, SITE } from '@/config/site';
import type { SessionUser } from '@/features/auth/types';
import { isPathActive } from '@/shared/ui';
import MobileNav from './MobileNav';
import UserMenu from './UserMenu';

interface Props {
  user: SessionUser | null;
}

const { user } = Astro.props;
const currentPath = Astro.url.pathname;
// Giriş sonrası kullanıcıyı bulunduğu sayfaya geri getirmek için (auth sayfalarının kendisi hariç).
const isAuthPage = [ROUTES.login, ROUTES.register, ROUTES.forgotPassword, ROUTES.resetPassword].includes(currentPath as never);
const loginHref = isAuthPage || currentPath === '/' ? ROUTES.login : `${ROUTES.login}?redirect=${encodeURIComponent(currentPath + Astro.url.search)}`;
---

<!-- view-transition-name: sayfa geçişinde header yerinde sabit kalır; header-elevate: kaydırınca gölge -->
<!-- backdrop-filter sabit konumlu mobil panel için containing block oluşturduğu için header katmanında kullanılmaz. -->
<header class="header-elevate sticky top-0 z-50 border-b border-slate-100 bg-white/95" style="view-transition-name: site-header">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 md:h-20 lg:px-8">
    <a href={ROUTES.home} class="flex shrink-0 items-center" aria-label={`${SITE.name} ana sayfa`}>
      <img src={SITE.logo} alt={`${SITE.name} logo`} width="150" height="40" class="h-auto w-[112px] md:w-[150px]" />
    </a>

    <!-- Masaüstü menü -->
    <nav aria-label="Ana menü" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-semibold text-gray-500">
        {
          MAIN_NAV.map(({ label, href }) => {
            const active = isPathActive(href, currentPath);
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={['group relative py-2 transition-colors hover:text-primary-600', active && 'text-primary-600']}
                >
                  {label}
                  <span
                    class:list={[
                      'absolute bottom-0 left-0 h-0.5 origin-left bg-primary-600 transition-transform duration-300 ease-smooth group-hover:scale-x-100 w-full',
                      active ? 'scale-x-100' : 'scale-x-0',
                    ]}
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Aksiyonlar -->
    <div class="flex items-center gap-2 sm:gap-3 md:gap-4">
      {
        user ? (
          <div class="hidden lg:block">
            <UserMenu client:idle user={user} />
          </div>
        ) : (
          <>
            <a href={loginHref} class="hidden rounded-xl px-3 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-primary-50 hover:text-primary-700 lg:inline-flex">
              Giriş Yap
            </a>
            <a
              href={ROUTES.register}
              class="hidden rounded-2xl bg-primary-700 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary-700/15 transition hover:bg-primary-800 lg:inline-flex md:px-6"
            >
              Kayıt Ol
            </a>
          </>
        )
      }
      <MobileNav client:idle user={user} currentPath={currentPath} loginHref={loginHref} />
    </div>
  </div>
</header>
