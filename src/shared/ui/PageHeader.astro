---
/**
 * [MODÜL: SAYFA BAŞLIĞI — UI GENİŞLETMESİ]
 * Amaç: Liste ve statik sayfaların üst bölümünü (konum, başlık, açıklama, aksiyon alanı) tek
 *       tasarımla sunmak. `slot` alanına arama/filtre çubuğu yerleştirilir.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './types';
import Container from './Container.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  breadcrumbs?: Crumb[];
}

const { title, description, eyebrow, breadcrumbs = [] } = Astro.props;
---

<!--
  Bölüm `overflow-hidden` DEĞİL: içindeki filtre panelleri bölümün altına taşabilmeli.
  Yalnızca dekoratif ışık efekti kendi kırpılmış katmanında tutulur (yatay kaydırma oluşmaz).
-->
<section class="relative z-20 border-b border-slate-200/70 bg-linear-to-b from-slate-50 via-white to-primary-50/35">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-primary-200/25 blur-3xl"></div>
    <div class="absolute -bottom-36 left-1/4 h-64 w-64 rounded-full bg-blue-100/25 blur-3xl"></div>
    <div class="absolute right-[8%] top-12 h-28 w-28 opacity-[0.16] [background-image:radial-gradient(var(--color-primary-400)_1px,transparent_1px)] [background-size:14px_14px]"></div>
  </div>
  <Container class="relative py-8 md:py-12">
    {breadcrumbs.length > 0 && <div class="mb-6 flex justify-center"><Breadcrumbs items={breadcrumbs} /></div>}
    <div class="mx-auto max-w-3xl text-center">
      {
        eyebrow && (
          <p class="mb-3 flex items-center justify-center gap-2 text-[11px] font-semibold uppercase tracking-[0.13em] text-primary-700 sm:text-xs">
            <span class="h-2 w-2 rounded-full bg-primary-600 shadow-[0_0_0_4px_var(--color-primary-100)]" aria-hidden="true"></span>
            {eyebrow}
          </p>
        )
      }
      <h1 class="text-3xl font-extrabold leading-[1.12] tracking-[-0.03em] text-slate-950 sm:text-5xl md:text-[3.35rem] md:leading-[1.08]">{title}</h1>
      {description && <p class="mx-auto mt-4 max-w-2xl text-base font-normal leading-7 text-slate-500 md:text-[1.0625rem]">{description}</p>}
    </div>
    {
      Astro.slots.has('default') && (
        <div class="mx-auto mt-8 max-w-5xl">
          <slot />
        </div>
      )
    }
  </Container>
</section>
