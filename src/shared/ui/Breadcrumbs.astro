---
/**
 * [MODÜL: EKMEK KIRINTISI — UI GENİŞLETMESİ]
 * Amaç: Kullanıcıya sitedeki konumunu göstermek ve arama motorlarına BreadcrumbList şeması vermek.
 * Son öğe bağlantısızdır ve `aria-current="page"` taşır.
 */
import { ChevronRight, House } from 'lucide-react';
import { SITE } from '@/config/site';
import type { Crumb } from './types';

interface Props {
  items: Crumb[];
  /** Koyu arka plan üzerinde (ör. kapak görseli) açık renk kullanılır. */
  tone?: 'default' | 'light';
}

const { items, tone = 'default' } = Astro.props;
const all: Crumb[] = [{ label: 'Ana Sayfa', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, SITE.url).href } : {}),
  })),
};
const light = tone === 'light';
---

<nav aria-label="Konum" class="min-w-0">
  <ol class:list={['flex min-w-0 items-center gap-1 text-xs font-medium sm:text-sm', light ? 'text-white/70' : 'text-gray-500']}>
    {
      all.map((item, index) => {
        const isLast = index === all.length - 1;
        return (
          <li class:list={['flex min-w-0 items-center gap-1', !isLast && index > 0 && 'hidden sm:flex']}>
            {index > 0 && <ChevronRight size={14} className="shrink-0 opacity-60" aria-hidden="true" />}
            {isLast || !item.href ? (
              <span aria-current={isLast ? 'page' : undefined} class:list={['truncate', light ? 'text-white' : 'text-gray-900', 'font-semibold']}>
                {item.label}
              </span>
            ) : (
              <a href={item.href} class:list={['flex items-center gap-1 transition', light ? 'hover:text-white' : 'hover:text-primary-600']}>
                {index === 0 && <House size={14} aria-hidden="true" />}
                <span class:list={[index === 0 && 'sr-only sm:not-sr-only']}>{item.label}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
