---
/**
 * [MODÜL: KURUM ATFI — UI GENİŞLETMESİ]
 * Amaç: İlan ve etkinlik kartlarında içeriği yayımlayan kurumu logo, bağlam etiketi ve
 *       profil bağlantısıyla belirgin biçimde göstermek.
 * Neden: Kurum bilgisinin farklı kartlarda küçük bir metne dönüşmesini önler ve aynı
 *        görsel hiyerarşiyi ortak bir bileşende korur (DRY).
 */
import CompanyLogo from './CompanyLogo.astro';

interface Props {
  name: string;
  logoUrl: string | null;
  href: string;
  label: string;
}

const { name, logoUrl, href, label } = Astro.props;
---

<a
  href={href}
  class="group/organization relative z-20 mx-auto flex min-h-11 max-w-[calc(100%-2rem)] flex-col items-center text-center focus-visible:rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-500/20"
  aria-label={`${name} kurum profilini incele`}
>
  <CompanyLogo name={name} src={logoUrl} size="md" class="ring-4 ring-white transition-transform duration-300 group-hover/organization:-translate-y-0.5" />
  <span class="mt-2 min-w-0 max-w-full">
    <span class="block text-[9px] font-semibold uppercase tracking-[0.12em] text-slate-400">{label}</span>
    <strong class="mt-0.5 block truncate text-sm font-semibold text-slate-900 transition-colors group-hover/organization:text-primary-700">{name}</strong>
  </span>
</a>
