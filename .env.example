# Youthside API kök adresi (sonunda / olmadan).
# Canlı: https://api.youthside.co/api · Yerel: http://localhost/youthside_ats/public/api
PUBLIC_API_URL=https://api.youthside.co/api

# OAuth istemci kimlikleri (varsayılanlar astro.config.mjs'te). Sağlayıcı panelinde kayıtlı olmalı:
#   Google  → Authorized JavaScript origins: http://localhost:4321, https://youthside.co
#   LinkedIn → Authorized redirect URLs:    http://localhost:4321/linkedin-callback/, https://youthside.co/linkedin-callback/
# GOOGLE_CLIENT_ID=
# LINKEDIN_CLIENT_ID=
